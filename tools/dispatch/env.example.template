# Gmail -> Xero bill automation — environment template
#
# Copy to .env in the repo root and fill with real values:
#     cp .env.example .env
# .env is gitignored. This file holds PLACEHOLDERS ONLY — never real values.
#
# If any real credential was ever committed, rotate it in the Google Cloud
# Console / Xero developer portal. Removing the file is not enough.

# --- Google / Gmail OAuth -------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=you@example.com

# Gmail search selecting bills to process, e.g. "label:bills is:unread"
GMAIL_QUERY=label:bills is:unread

# --- Xero OAuth -----------------------------------------------------------
# https://developer.xero.com/app/manage
XERO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
XERO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XERO_TENANT_ID=00000000-0000-0000-0000-000000000000
XERO_REDIRECT_URI=http://localhost:8080/callback
XERO_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XERO_SCOPES=offline_access accounting.transactions accounting.contacts

# --- Local paths ----------------------------------------------------------
# Keep token and database files OUTSIDE the repo so they can never be
# committed, and outside any Google Drive synced folder.
TOKEN_STORE_DIR=/Users/CHANGEME/.config/bill-automation
IDEMPOTENCY_DB_PATH=/Users/CHANGEME/.local/share/bill-automation/processed.sqlite

# --- Behaviour ------------------------------------------------------------
# Leave DRY_RUN=true until a full run has been verified against real data.
DRY_RUN=true
LOG_LEVEL=INFO
